{
  "name": "@whoburnedmore/burnbar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BurnBar — native macOS menu bar app for live AI token burn + usage limits. Swift shell + bun-compiled sidecar.",
  "scripts": {
